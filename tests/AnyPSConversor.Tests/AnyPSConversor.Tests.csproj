<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Only the UI-free logic: the tests do not need the app's embedded dependencies. -->
  <ItemGroup>
    <Compile Include="..\..\src\AnyPSConversor\SelfUnwrapper.cs" Link="SelfUnwrapper.cs" />
    <Compile Include="..\..\src\AnyPSConversor\GameInfo.cs" Link="GameInfo.cs" />
    <Compile Include="..\..\src\AnyPSConversor\Converter.cs" Link="Converter.cs" />
    <Compile Include="..\..\src\AnyPSConversor\Archives.cs" Link="Archives.cs" />
    <Compile Include="..\..\src\AnyPSConversor\SourceCleanup.cs" Link="SourceCleanup.cs" />
    <Compile Include="..\..\src\AnyPSConversor\DiskSpace.cs" Link="DiskSpace.cs" />
    <Compile Include="..\..\src\AnyPSConversor\Settings.cs" Link="Settings.cs" />
    <Compile Include="..\..\src\AnyPSConversor\ConsolePlatform.cs" Link="ConsolePlatform.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- With the dependencies downloaded, the real conversion test uses the same relinker and libraries as the app. -->
  <ItemGroup Condition="Exists('..\..\deps\VERSION')">
    <EmbeddedResource Include="..\..\deps\relinker.exe" LogicalName="relinker.exe" />
    <EmbeddedResource Include="..\..\deps\prx-windows.zip" LogicalName="prx-windows.zip" />
    <EmbeddedResource Include="..\..\deps\VERSION" LogicalName="anyps5-version" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
