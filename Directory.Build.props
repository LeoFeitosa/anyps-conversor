<Project>
  <PropertyGroup>
    <!-- Versão do app (SemVer), única fonte da verdade: a tag vX.Y.Z precisa ser igual, senão o build falha.
         Builds fora de uma tag recebem o sufixo -dev.N e aparecem assim no rodapé do programa. -->
    <VersionPrefix>0.7.0</VersionPrefix>
    <Authors>LeoFeitosa</Authors>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Caminhos da máquina de build não vão para o executável. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
